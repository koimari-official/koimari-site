        ".write": "(auth != null && (auth.token.firebase.sign_in_provider === 'password' || auth.token.koimariAdmin === 'full' || auth.token.koimariAdmin === 'store') && ((auth.token.store !== true && auth.token.koimariAdmin !== 'store') || newData.exists())) || !data.exists()",
