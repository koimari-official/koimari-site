        ".write": "auth != null && auth.token.koimariAdmin === 'store'"
      },
      "news": {
        ".write": "auth != null && auth.token.koimariAdmin === 'store'"
      },
      "gallery": {
        ".write": "auth != null && auth.token.koimariAdmin === 'store'"
      },
      "faq": {
        ".write": "auth != null && auth.token.koimariAdmin === 'store'"
      }
    },
    "aiReviewQueue": {
      ".read": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full' || auth.token.koimariAdmin === 'store')",
      ".write": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full' || auth.token.koimariAdmin === 'store')"
    },
    "noritate": {
      "content": {
        ".read": true,
        ".write": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')"
      },
      "contacts": {
        ".read": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')",
        "$id": {
          ".write": "(auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')) || !data.exists()",
          ".validate": "newData.hasChildren(['name', 'email', 'message', 'submittedAt']) && newData.child('name').isString() && newData.child('name').val().length <= 100 && newData.child('email').isString() && newData.child('email').val().length <= 200 && newData.child('message').isString() && newData.child('message').val().length <= 5000",
          "submittedAt": {
            ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z?$/)"
          },
          "status": {
            ".validate": "newData.isString() && (newData.val() === '未対応' || (auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')))"
          },
          "memo": {
            ".validate": "(auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')) && newData.isString() && newData.val().length <= 2000"
          },
          "memoAt": {
            ".validate": "(auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')) && newData.isString() && newData.val().length <= 40"
          },
