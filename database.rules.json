            ".validate": "newData.isNumber()"
          },
          "pendingDraftAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')"
          }
        },
        "orders": {
          "$oid": {
            ".write": "$uid.matches(/^U[0-9a-f]{32}$/) && root.child('lineMembers').child($uid).exists() && !data.exists() && $oid.matches(/^-[A-Za-z0-9_-]{19}$/)",
            ".validate": "newData.hasChildren(['savedAt'])",
            "savedAt": {
              ".validate": "newData.isNumber()"
            },
            "pickupDate": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            },
            "subtotal": {
              ".validate": "newData.isNumber()"
            },
            "headline": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "spec": {
              ".validate": "newData.isString() && newData.val().length <= 4000"
            },
            "$other": {
              ".validate": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')"
            }
          }
        },
        "$other": {
          ".validate": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')"
        }
      }
    },
    "sweetsLab": {
      ".read": "auth != null && auth.token.regular === true",
      ".write": "auth != null && auth.token.regular === true"
    },
    "pushSubs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$sid": {
          ".validate": "newData.child('sub').child('endpoint').isString()"
        }
      }
    },
    "pushLog": {
      ".read": false,
      ".write": false
    },
    "bulletin": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role === 'owner' || auth.token.role === 'manager')"
    },
    "sessionTrash": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "reservationVerify": {
      "$id": {
        ".read": false,
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['t', 'at']) && newData.child('t').isString() && newData.child('t').val().length < 2000 && newData.child('at').isNumber()"
      }
    }
