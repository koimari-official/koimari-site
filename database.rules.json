{
  "rules": {
    "dashboardTasks": {
      ".read": "auth != null && auth.token.store !== true",
      ".write": "auth != null && auth.token.store !== true"
    },
    "sessions": {
      ".read": true,
      ".write": true
    },
    "lineup": {
      ".read": true,
      ".write": true
    },
    "trash": {
      ".read": "auth != null && auth.token.store !== true",
      ".write": "auth != null && auth.token.store !== true"
    },
    "staffRequests": {
      ".read": "auth != null && auth.token.store !== true",
      "$id": {
        ".write": "(auth != null && auth.token.store !== true) || (!data.exists() && newData.child('status').val() === 'pending')"
      }
    },
    "reservations": {
      ".read": "auth != null",
      "$id": {
        ".write": "(auth != null && (auth.token.store !== true || newData.exists())) || !data.exists()",
        "reservationNo": {
          ".read": true
        }
      }
    },
    "reservationDrafts": {
      "$code": {
        ".read": true,
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'productType', 'createdAt']) && newData.child('name').isString() && newData.child('name').val().length <= 120 && newData.child('productType').isString() && newData.child('productType').val().length <= 30 && (!newData.child('img').exists() || (newData.child('img').isString() && newData.child('img').val().length <= 600)) && (!newData.child('price').exists() || (newData.child('price').isString() && newData.child('price').val().length <= 60)) && (!newData.child('size').exists() || (newData.child('size').isString() && newData.child('size').val().length <= 40)) && (!newData.child('spec').exists() || (newData.child('spec').isString() && newData.child('spec').val().length <= 6000))"
      }
    },
    "experiences": {
      ".read": "auth != null && auth.token.store !== true",
      "$id": {
        ".write": "(auth != null && auth.token.store !== true) || !data.exists()"
      }
    },
    "siteConfig": {
      ".read": true,
      ".write": "auth != null && auth.token.store !== true"
    },
    "meishiDesigns": {
      ".read": "auth != null && auth.token.store !== true",
      ".write": "auth != null && auth.token.store !== true"
    },
    "koimariContent": {
      ".read": true,
      ".write": "auth != null && auth.token.store !== true"
    },
    "noritate": {
      ".read": true,
      ".write": "auth != null && auth.token.store !== true"
    },
    "siteImages": {
      ".read": true,
      ".write": "auth != null && auth.token.store !== true"
    },
    "koimariOps": {
      ".read": "auth != null && auth.token.store !== true",
      ".write": "auth != null && auth.token.store !== true"
    },
    "lineMembers": {
      ".read": "auth != null && auth.token.store !== true",
      "$uid": {
        ".read": true,
        ".write": "(auth != null && auth.token.store !== true) || !data.exists()",
        "profile": {
          ".write": true
        },
        "orders": {
          ".write": true,
          "$oid": {
            ".validate": "newData.hasChildren(['savedAt'])"
          }
        }
      }
    },
    "sweetsLab": {
      ".read": "auth != null && auth.token.regular === true",
      ".write": "auth != null && auth.token.regular === true"
    }
  }
}
