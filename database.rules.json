    "reservationDrafts": {
      "$code": {
        ".read": true,
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'productType', 'createdAt']) && newData.child('name').isString() && newData.child('name').val().length <= 120 && !newData.child('name').val().contains('<') && !newData.child('name').val().contains('>') && newData.child('productType').isString() && newData.child('productType').val().length <= 30 && !newData.child('productType').val().contains('<') && !newData.child('productType').val().contains('>') && (!newData.child('img').exists() || (newData.child('img').isString() && newData.child('img').val().length <= 600 && newData.child('img').val().matches(/^https?:[/][/][^<>\"' ]+$/))) && (!newData.child('price').exists() || (newData.child('price').isString() && newData.child('price').val().length <= 60 && !newData.child('price').val().contains('<') && !newData.child('price').val().contains('>'))) && (!newData.child('size').exists() || (newData.child('size').isString() && newData.child('size').val().length <= 40 && !newData.child('size').val().contains('<') && !newData.child('size').val().contains('>'))) && (!newData.child('spec').exists() || (newData.child('spec').isString() && newData.child('spec').val().length <= 6000))"
      }
    },
