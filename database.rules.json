{
  "rules": {
    "dashboardTasks": {
      ".read": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')",
      ".write": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')"
    },
    "sessions": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "lineup": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "trash": {
      ".read": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')",
      ".write": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')"
    },
    "staffRequests": {
      ".read": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')",
      "$id": {
        ".write": "(auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')) || (!data.exists() && newData.child('status').val() === 'pending')"
      }
    },
    "customerFlags": {
      ".read": "auth != null && (auth.token.firebase.sign_in_provider === 'password' || auth.token.koimariAdmin === 'full' || auth.token.koimariAdmin === 'store')",
      ".write": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')"
    },
    "reservationStaff": {
      ".read": "auth != null && (auth.token.firebase.sign_in_provider === 'password' || auth.token.koimariAdmin === 'full' || auth.token.koimariAdmin === 'store')",
      ".write": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')"
    },
    "reservations": {
      ".read": "auth != null && (auth.token.firebase.sign_in_provider === 'password' || auth.token.koimariAdmin === 'full' || auth.token.koimariAdmin === 'store')",
      ".indexOn": [
        "lineUserId"
      ],
      "$id": {
        ".write": "(auth != null && (auth.token.firebase.sign_in_provider === 'password' || auth.token.koimariAdmin === 'full' || auth.token.koimariAdmin === 'store') && ((auth.token.store !== true && auth.token.koimariAdmin !== 'store') || newData.exists())) || !data.exists()",
        "reservationNo": {
          ".read": true
        }
      }
    },
    "reservationDrafts": {
      "$code": {
        ".read": true,
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['name', 'productType', 'createdAt']) && newData.child('name').isString() && newData.child('name').val().length <= 120 && newData.child('productType').isString() && newData.child('productType').val().length <= 30 && (!newData.child('img').exists() || (newData.child('img').isString() && newData.child('img').val().length <= 600)) && (!newData.child('price').exists() || (newData.child('price').isString() && newData.child('price').val().length <= 60)) && (!newData.child('size').exists() || (newData.child('size').isString() && newData.child('size').val().length <= 40)) && (!newData.child('spec').exists() || (newData.child('spec').isString() && newData.child('spec').val().length <= 6000))"
      }
    },
    "experiences": {
      ".read": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')",
      "$id": {
        ".write": "(auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')) || !data.exists()"
      }
    },
    "siteConfig": {
      ".read": true,
      ".write": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')"
    },
    "meishiDesigns": {
      ".read": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')",
      ".write": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')"
    },
    "koimariContent": {
      ".read": true,
      ".write": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')"
    },
    "noritate": {
      ".read": true,
      ".write": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')"
    },
    "siteImages": {
      ".read": true,
      ".write": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')"
    },
    "koimariOps": {
      ".read": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')",
      ".write": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')"
    },
    "lineMembers": {
      ".read": "auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')",
      "$uid": {
        ".read": true,
        ".write": "(auth != null && ((auth.token.firebase.sign_in_provider === 'password' && auth.token.store !== true) || auth.token.koimariAdmin === 'full')) || !data.exists()",
        "profile": {
          ".write": true
        },
        "orders": {
          ".write": true,
          "$oid": {
            ".validate": "newData.hasChildren(['savedAt'])"
          }
        }
      }
    },
    "sweetsLab": {
      ".read": "auth != null && auth.token.regular === true",
      ".write": "auth != null && auth.token.regular === true"
    },
    "pushSubs": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$sid": {
          ".validate": "newData.child('sub').child('endpoint').isString()"
        }
      }
    },
    "pushLog": {
      ".read": false,
      ".write": false
    },
    "bulletin": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role === 'owner' || auth.token.role === 'manager')"
    },
    "sessionTrash": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
